<Application x:Class="Spellbook.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#140D08"/>
    <SolidColorBrush x:Key="Panel" Color="#201609"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#2B1D0B"/>
    <SolidColorBrush x:Key="Line" Color="#4A3417"/>
    <SolidColorBrush x:Key="Gold" Color="#F0C878"/>
    <SolidColorBrush x:Key="Muted" Color="#B8A37F"/>
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Text" Color="#F1E3C4"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PanelSoft}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Violet}"/></Trigger></Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
