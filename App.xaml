<Application x:Class="Spellbook.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#140D08"/>
    <SolidColorBrush x:Key="Panel" Color="#201609"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#2B1D0B"/>
    <SolidColorBrush x:Key="Line" Color="#4A3417"/>
    <SolidColorBrush x:Key="Gold" Color="#F0C878"/>
    <SolidColorBrush x:Key="Muted" Color="#B8A37F"/>
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Text" Color="#F1E3C4"/>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Background" Value="#2B1D0B"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A78BFA"/><Setter TargetName="Shell" Property="Background" Value="#39234D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#211331"/><Setter TargetName="Shell" Property="BorderBrush" Value="#F0C878"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#6D28D9"/><Setter Property="BorderBrush" Value="#9D71F7"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#301914"/><Setter Property="BorderBrush" Value="#6A3828"/><Setter Property="Foreground" Value="#E6C2AD"/></Style>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#39234D"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemShell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#2A1B38"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#39234D"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="#8B5CF6"/><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#2B1D0B"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Foreground="{StaticResource Text}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="10,7"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{StaticResource Text}" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" Margin="0,4,0,0" Background="#241808" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6"><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="11,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="Transparent" CornerRadius="4" Margin="3"><ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{StaticResource Text}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#39234D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#4C2D66"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="#170F08" CornerRadius="5" Padding="2"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#6D4A9A"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbShell" Background="{TemplateBinding Background}" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbShell" Property="Background" Value="#A78BFA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
