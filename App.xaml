<Application x:Class="Spellbook.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#140D08"/>
    <SolidColorBrush x:Key="Panel" Color="#201609"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#2B1D0B"/>
    <SolidColorBrush x:Key="Line" Color="#4A3417"/>
    <SolidColorBrush x:Key="Gold" Color="#F0C878"/>
    <SolidColorBrush x:Key="Muted" Color="#B8A37F"/>
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Text" Color="#F1E3C4"/>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Background" Value="#2B1D0B"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A78BFA"/><Setter TargetName="Shell" Property="Background" Value="#39234D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#211331"/><Setter TargetName="Shell" Property="BorderBrush" Value="#F0C878"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#6D28D9"/><Setter Property="BorderBrush" Value="#9D71F7"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="#301914"/><Setter Property="BorderBrush" Value="#6A3828"/><Setter Property="Foreground" Value="#E6C2AD"/></Style>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#39234D"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
  </Application.Resources>
</Application>
