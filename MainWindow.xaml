<Window x:Class="Spellbook.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spellbook" Icon="Assets/spellbook-logo.png" Width="1120" Height="720" MinWidth="900" MinHeight="600" Background="Transparent" Foreground="{StaticResource Text}" FontFamily="Georgia" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{StaticResource Ink}" BorderBrush="#4A3417" BorderThickness="1" CornerRadius="14"><Grid Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="3" Background="#201609" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="22,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" Background="#2B1D0B" BorderBrush="{StaticResource Violet}" BorderThickness="1" CornerRadius="9"><Image Source="/Assets/spellbook-logo.png" Stretch="Uniform" Margin="3"/></Border>
        <StackPanel Grid.Column="2"><TextBlock Text="S P E L L B O O K" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gold}"/><TextBlock Text="AUTOMAÇÕES LOCAIS · MOUSE E TECLADO" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Status da automação"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#6EE0A8"/><TextBlock x:Name="StatusText" Text="EM ESPERA" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,10,0" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource TitleButton}" Click="Minimize_Click" Content="—"/><Button Style="{StaticResource TitleButton}" Click="Maximize_Click" Content="□"/><Button Style="{StaticResource TitleButton}" Click="Close_Click" Content="×" Foreground="#E6C2AD"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Grid.Column="0" Margin="28,0,0,24" Background="#201609" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Style="{StaticResource PrimaryButton}" Click="NewSpell_Click" Content="✦  NOVO FEITIÇO"/><Button Style="{StaticResource DangerButton}" Click="DeleteSpell_Click" Content="⌫  EXCLUIR FEITIÇO" Margin="0,8,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="G R I M Ó R I O" FontSize="12" Foreground="{StaticResource Gold}" FontWeight="Bold" Margin="4,0,0,10"/>
          <ListBox x:Name="SpellsList" SelectionChanged="SpellsList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" DisplayMemberPath="Name"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Grid.Column="2" Margin="24,0,28,24" Background="#201609" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="28">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="C O N J U R A R  U M A  A Ç Ã O" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold"/>
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" FontFamily="Georgia" FontSize="28" Padding="0,12,0,10"/>
        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="115"/><ColumnDefinition Width="18"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="TIPO DE FEITIÇO" Foreground="{StaticResource Muted}" FontSize="11"/><ComboBox x:Name="TypeBox" SelectionChanged="TypeBox_SelectionChanged" Background="#2B1D0B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Padding="7,5" Margin="0,6,0,0"><ComboBoxItem Content="Gravado"/><ComboBoxItem Content="Autoclicker"/><ComboBoxItem Content="Manual"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="ATALHO GLOBAL" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown" ToolTip="Clique aqui e pressione a tecla ou combinação desejada" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" CaretBrush="Transparent" Padding="10,8" Margin="0,6,0,0"/></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="REPETIÇÕES" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="RepeatBox" Text="1" TextChanged="DetailsChanged" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="10,8" Margin="0,6,0,0"/></StackPanel>
          <StackPanel Grid.Column="6"><TextBlock Text="DURAÇÃO" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DurationText" Text="0s" Foreground="{StaticResource Gold}" FontSize="18" Margin="0,8,0,0"/></StackPanel>
        </Grid>
        <Border x:Name="AutoClickerPanel" Visibility="Collapsed" Background="#170F08" BorderBrush="#604291" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,20,0,0"><StackPanel>
          <TextBlock Text="A U T O C L I C K E R" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold"/>
          <TextBlock Text="Defina os cliques sem precisar gravar uma sequência. A quantidade usa o campo Repetições acima. O mínimo é 10 ms; pressione Esc a qualquer momento para interromper." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,14"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="14"/><ColumnDefinition Width="125"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="BOTÃO" Foreground="{StaticResource Muted}" FontSize="11"/><ComboBox x:Name="ClickButtonBox" SelectionChanged="AutoClickerChanged" Background="#2B1D0B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Padding="7,5" Margin="0,6,0,0"><ComboBoxItem Content="Esquerdo"/><ComboBoxItem Content="Direito"/><ComboBoxItem Content="Meio"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="INTERVALO (ms)" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="IntervalBox" TextChanged="AutoClickerChanged" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="10,8" Margin="0,6,0,0"/><TextBlock Text="CLIQUE POR CICLO" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/><ComboBox x:Name="ClickStyleBox" SelectionChanged="AutoClickerChanged" Background="#2B1D0B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Padding="7,5" Margin="0,6,0,0"><ComboBoxItem Content="Simples"/><ComboBoxItem Content="Duplo"/><ComboBoxItem Content="Triplo"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="4"><CheckBox x:Name="UnlimitedBox" Checked="AutoClickerChanged" Unchecked="AutoClickerChanged" Content="Repetir continuamente" Foreground="{StaticResource Text}" Margin="0,2,0,7"/><CheckBox x:Name="FixedPositionBox" Checked="AutoClickerChanged" Unchecked="AutoClickerChanged" Content="Usar posição fixa" Foreground="{StaticResource Text}" Margin="0,2,0,7"/><WrapPanel><TextBox x:Name="AutoXBox" Width="75" TextChanged="AutoClickerChanged" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6"/><TextBlock Text="  ×  " Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="AutoYBox" Width="75" TextChanged="AutoClickerChanged" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6"/></WrapPanel></StackPanel>
          </Grid>
        </StackPanel></Border>
        <Border x:Name="ManualPanel" Visibility="Collapsed" Background="#170F08" BorderBrush="#604291" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,20,0,0"><StackPanel>
          <TextBlock Text="C O N S T R U I R  M A N U A L M E N T E" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold"/>
          <TextBlock Text="Adicione ações diretamente: tecla, clique, movimento, rolagem ou pausa. O atraso é o tempo antes da ação." Foreground="{StaticResource Muted}" Margin="0,7,0,14"/>
          <WrapPanel><StackPanel Width="150"><TextBlock Text="AÇÃO" Foreground="{StaticResource Muted}" FontSize="11"/><ComboBox x:Name="ManualTypeBox" Background="#2B1D0B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" Padding="7,5" Margin="0,6,0,0"><ComboBoxItem Content="Pressionar tecla"/><ComboBoxItem Content="Soltar tecla"/><ComboBoxItem Content="Clique esquerdo"/><ComboBoxItem Content="Clique direito"/><ComboBoxItem Content="Mover mouse"/><ComboBoxItem Content="Rolar mouse"/><ComboBoxItem Content="Esperar"/></ComboBox></StackPanel><StackPanel Width="90" Margin="10,0,0,0"><TextBlock Text="TECLA/VALOR" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ManualValueBox" Text="A" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6" Margin="0,6,0,0"/></StackPanel><StackPanel Width="75" Margin="10,0,0,0"><TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ManualXBox" Text="0" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6" Margin="0,6,0,0"/></StackPanel><StackPanel Width="75" Margin="10,0,0,0"><TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ManualYBox" Text="0" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6" Margin="0,6,0,0"/></StackPanel><StackPanel Width="105" Margin="10,0,0,0"><TextBlock Text="ATRASO (ms)" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ManualDelayBox" Text="100" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" Padding="8,6" Margin="0,6,0,0"/></StackPanel><Button Click="AddManualAction_Click" Content="＋ ADICIONAR" Margin="10,17,0,0"/></WrapPanel>
        </StackPanel></Border>
        <Border x:Name="RecordingPanel" Background="#170F08" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,28,0,0"><StackPanel>
          <TextBlock Text="C Í R C U L O  D E  G R A V A Ç Ã O" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold"/>
          <TextBlock Text="Ao iniciar, o Spellbook se minimiza automaticamente. Execute a sequência e pressione a tecla configurada abaixo para parar a gravação e trazer o app de volta." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,15"/>
          <StackPanel Width="230" Margin="0,0,0,14"><TextBlock Text="TECLA PARA PARAR GRAVAÇÃO" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="RecordingStopBox" IsReadOnly="True" PreviewMouseLeftButtonDown="RecordingStopBox_PreviewMouseLeftButtonDown" ToolTip="Clique aqui e pressione a tecla ou combinação desejada" Background="#2B1D0B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" CaretBrush="Transparent" Padding="10,8" Margin="0,6,0,0"/></StackPanel>
          <Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}" Click="RecordButton_Click" Content="●  GRAVAR · F8 PARA PARAR" HorizontalAlignment="Left"/>
        </StackPanel></Border>
        <WrapPanel Margin="0,14,0,0"><Button x:Name="PlayButton" Click="PlayButton_Click" Content="▷  TESTAR FEITIÇO"/><Button Style="{StaticResource DangerButton}" Click="ClearButton_Click" Content="⌫  LIMPAR" Margin="10,0,0,0"/></WrapPanel>
        <TextBlock Text="S E Q U Ê N C I A  R E G I S T R A D A" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="Bold" Margin="0,28,0,10"/>
        <ListBox x:Name="EventsList" Height="130" Background="#170F08" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Muted}"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="28,0,28,18" Padding="8,0" Background="Transparent"><TextBlock Text="Seus feitiços são salvos automaticamente e apenas neste computador." Foreground="{StaticResource Muted}" FontSize="11"/></Border>
  </Grid></Border>
</Window>
